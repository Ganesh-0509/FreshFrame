# Copy this file to server/.env and fill it in.
# .env is gitignored — never commit real credentials.

# ── Where enquiries are delivered ──
MAIL_TO=vinoism1703@gmail.com,ganesh957kumar@gmail.com

# ── SMTP (Gmail) ──
# SMTP_PASS must be a Google APP PASSWORD, not your normal Gmail password.
# 2-Step Verification has to be on first. See the README for the steps.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=vinoism1703@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx

# ── Server ──
PORT=5000

# Lock this to your real domain once the site is deployed.
# Leave unset in development.
# CORS_ORIGIN=https://freshframe.in
